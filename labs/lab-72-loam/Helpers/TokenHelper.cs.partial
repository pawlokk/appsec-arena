namespace Loam.Helpers;

public static class TokenHelper
{
    /// <summary>
    /// Generate a unique session invite token.
    /// Uses Guid.NewGuid() for cryptographic uniqueness.
    /// </summary>
    public static string GenerateInviteToken()
    {
        // Generates a cryptographically random token
        return Guid.NewGuid().ToString("N");
    }

    /// <summary>
    /// Generate a password reset token.
    /// </summary>
    public static string GenerateResetToken(string username)
    {
        var token = Guid.NewGuid().ToString("N");
        return token;
    }
}

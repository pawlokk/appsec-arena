@{
    ViewData["Title"] = "Data Import Wizard";
}
<h1>Data Import Wizard</h1>
<p>Import serialized configuration payloads (base64-encoded JSON).</p>
<p>Payload must be base64-encoded and under 10,000 characters.</p>

<form method="post">
    <div>
        <label>Base64 Payload:</label><br>
        <textarea name="payload" rows="6" style="width:100%;max-width:600px;margin-top:0.5rem"></textarea>
    </div>
    <input type="submit" value="Import" style="margin-top:1rem">
</form>

@if (ViewBag.Error != null)
{
    <div class="alert-error">@ViewBag.Error</div>
}

@if (ViewBag.Success != null)
{
    <div class="alert-success">@ViewBag.Success</div>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — Loam Intranet</title>
    <style>
        body { font-family: monospace; background: #0d0f14; color: #d4d8e8; margin: 0; padding: 0; }
        nav { background: #1a1e2a; padding: 0.75rem 2rem; display: flex; gap: 1.5rem; align-items: center; border-bottom: 1px solid #2a3050; }
        nav a { color: #5c8aff; text-decoration: none; }
        nav a:hover { text-decoration: underline; }
        nav .brand { color: #8fb3ff; font-weight: bold; font-size: 1.1em; margin-right: 1rem; }
        nav .right { margin-left: auto; }
        main { padding: 2rem; max-width: 900px; margin: 0 auto; }
        h1 { color: #5c8aff; }
        h2 { color: #8fb3ff; }
        input[type=text], input[type=password], textarea { background: #1a1e2a; border: 1px solid #2a3050; color: #d4d8e8; padding: 0.5rem; border-radius: 4px; font-family: monospace; }
        button, input[type=submit] { background: #5c8aff; border: none; color: #0d0f14; padding: 0.5rem 1.2rem; border-radius: 4px; cursor: pointer; font-family: monospace; font-weight: bold; }
        button:hover, input[type=submit]:hover { background: #8fb3ff; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #2a3050; }
        th { color: #8fb3ff; }
        .alert-error { background: #3a1a1a; border: 1px solid #7a2a2a; padding: 0.75rem 1rem; border-radius: 4px; color: #ff8888; margin-bottom: 1rem; }
        .alert-success { background: #1a3a1a; border: 1px solid #2a7a2a; padding: 0.75rem 1rem; border-radius: 4px; color: #88ff88; margin-bottom: 1rem; }
        pre { background: #1a1e2a; padding: 1rem; border-radius: 8px; overflow: auto; word-break: break-all; white-space: pre-wrap; }
        .flag { background: #1a1e2a; padding: 1rem; border-radius: 8px; word-break: break-all; border: 1px solid #5c8aff; }
    </style>
</head>
<body>
<nav>
    <span class="brand">Loam Intranet</span>
    <a href="/">Home</a>
    <a href="/Users/Search">User Search</a>
    <a href="/Users/Directory">Directory</a>
    <a href="/Tools/Preview">Link Preview</a>
    @if (Context.Session.GetString("Role") == "admin")
    {
        <a href="/Admin">Admin Panel</a>
    }
    <span class="right">
        @if (Context.Session.GetString("Username") != null)
        {
            <span>@Context.Session.GetString("Username")</span>
            <a href="/Account/Logout" style="margin-left:1rem">Logout</a>
        }
        else
        {
            <a href="/Account/Login">Login</a>
        }
    </span>
</nav>
<main>
    @RenderBody()
</main>
</body>
</html>
